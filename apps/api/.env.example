ENVIRONMENT=local
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://targetforge:targetforge@localhost:5434/targetforge
AUTH_DISABLED_FOR_LOCAL_DEV=true

# --- LLM provider: "openai" for local dev against a real key, "azure_openai" in production ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o-mini

# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini
# AZURE_OPENAI_DEPLOYMENT_REASONING=gpt-4o

# --- External bioinformatics APIs (all free/keyless; email is a courtesy field NCBI requests) ---
NCBI_TOOL_EMAIL=research@targetforge.example
# PUBMED_API_KEY=

# --- Azure Batch (leave unset locally — falls back to FakeAlignmentBackend/FakeVariantCallingBackend) ---
# BATCH_ACCOUNT_URL=
# BATCH_POOL_ID=

# --- Azure Storage (leave unset locally) ---
# STORAGE_ACCOUNT_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
